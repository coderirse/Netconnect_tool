<?xml version="1.0" encoding="utf-8"?>
<!--
   备份规则：加密凭据（EncryptedSharedPreferences）的密钥保存在本机 AndroidKeystore，
   不随备份迁移；恢复到新设备后无法解密，必须排除，避免恢复到一堆解不开的数据。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="netconnect_credentials.xml" />
    <exclude domain="sharedpref" path="netconnect_credentials_fallback.xml" />
</full-backup-content>
