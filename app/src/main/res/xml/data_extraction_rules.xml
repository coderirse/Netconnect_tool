<?xml version="1.0" encoding="utf-8"?>
<!--
   数据提取规则（Android 12+）：排除加密凭据，原因同 backup_rules.xml ——
   密钥不出本机，备份/设备迁移过去的密文无法解密。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="netconnect_credentials.xml" />
        <exclude domain="sharedpref" path="netconnect_credentials_fallback.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="netconnect_credentials.xml" />
        <exclude domain="sharedpref" path="netconnect_credentials_fallback.xml" />
    </device-transfer>
</data-extraction-rules>
